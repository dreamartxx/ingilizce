# Hostinger ortam değişkenleri. Gerçek değerleri GitHub'a koymayın.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# İlk sahibi oluşturur. İlk başarılı girişten sonra OWNER_PASSWORD kaldırılabilir.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Yeni üyeler yalnızca bu kod ile kayıt olabilir. Boşsa kayıt kapalıdır.
REGISTRATION_CODE=
# OpenAI veya Chat Completions uyumlu sağlayıcı. Üçünü birlikte ayarlayın.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=40
